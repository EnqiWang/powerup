# Copy to .env (git-ignored) for local runs. On Render, set these in the dashboard (Environment), never in git.
# Never commit .env or paste keys into the browser. The browser only ever receives a per-call access token.

# --- Retell (both modes) ---
# Local signed-webhook tests: any dummy value works, e.g. RETELL_API_KEY=dummy-local-key
# Real Retell: the API key with the "webhook" badge (Settings → API Keys). Also verifies webhook signatures.
RETELL_API_KEY=
# Local: optional filter. Hosted: REQUIRED, the agent used for "Talk to AI" (agent_...).
RETELL_AGENT_ID=

# --- Local mode only (used when PORT is not set) ---
# APP_PORT=8014
# WEBHOOK_PORT=8015

# --- Hosted mode (enabled when PORT is set; Render sets PORT itself). API + webhooks only. ---
# Kill switch: live calls are OFF unless exactly "true".
RETELL_ENABLED=false
# Comma-separated sites allowed to call the backend (scheme + host, no path).
ALLOWED_ORIGINS=https://enqiwang.github.io
# Cloudflare Turnstile (Invisible widget). Test keys are refused unless TURNSTILE_ALLOW_TEST_KEYS=true (dev only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames a Turnstile token may come from (default: the ALLOWED_ORIGINS hostnames).
# TURNSTILE_HOSTNAMES=enqiwang.github.io
# TURNSTILE_ALLOW_TEST_KEYS=false
# Signs anonymous session tokens; keeps them valid across restarts. e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Credit protection (defaults shown). In memory per instance: reset by restarts/sleep, so also set
# spending limits in Retell (see DEPLOY-RENDER.md).
MAX_CALL_SECONDS=120
MAX_CONCURRENT_CALLS=2
MAX_CALLS_PER_DAY=20
SESSION_CALLS_PER_HOUR=2
IP_CALLS_PER_HOUR=4
# IP_SESSIONS_PER_HOUR=20
# Client IP for rate limits: "xff" = X-Forwarded-For entry TRUST_PROXY_HOPS from the RIGHT (never the
# client-written left end), "socket", or "header:<name>" for a platform-set header. Verify with DEBUG_CLIENT_IP.
CLIENT_IP_SOURCE=xff
TRUST_PROXY_HOPS=1
# DEBUG_CLIENT_IP=false
# RETELL_CREATE_WEB_CALL_PATH=/v3/create-web-call
